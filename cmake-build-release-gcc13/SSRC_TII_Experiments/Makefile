	cd /home/andtokm/DiskS/ProjectsUbuntu/CppProjects/cmake-build-release-gcc13 && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
